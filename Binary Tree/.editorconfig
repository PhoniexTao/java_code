# 告诉 EditorConfig 这是最顶层的配置文件，IDE 不会再向上查找
root = true

# 通配符规则，适用于所有文件
[*]
# 设置字符集
charset = utf-8
# 行尾格式
end_of_line = lf
# 文件末尾插入新行
insert_final_newline = true

# Java 文件专属配置
[*.java]
# 缩进风格：空格
indent_style = space
# 普通缩进大小：4
indent_size = 4
# 续行缩进大小：4 (这就是你需要的)
ij_continuation_indent_size = 4

# 配置文件专属
[*.{yml,yaml}]
indent_style = space
indent_size = 2